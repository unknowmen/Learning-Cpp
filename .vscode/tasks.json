{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "create build directory",
            "type": "process",
            "command": "/usr/bin/mkdir",
            "args": [
                "-p",
                "${workspaceFolder}/build"
            ],
            "problemMatcher": [],
            "hide": true
        },
        {
            "label": "build active C++ file",
            "type": "process",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++20",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "dependsOn": "create build directory",
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
